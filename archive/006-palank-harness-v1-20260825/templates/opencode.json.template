// templates/opencode.json.template — Palank Harness OpenCode Config Template (JSONC)
// Copy to ./opencode.json and adjust. JSONC comments (//) are for template only — remove or keep as JSON keys if your parser requires strict JSON.
// Raw: https://opencode.ai/docs/config  (opencode.json schema)
// Thin: harness is local (stdio), domain is remote (HTTP) — see mcp/README.md Thin vs Domain table.
{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "conductor": {
      "mode": "primary",
      "description": "Conductor — primary orchestrator, no direct edits. MUST delegate via Task to interpreter/verify.",
      "prompt": "You are Conductor. NEVER write/edit files yourself. First tool MUST be Task to interpreter or verify. See AGENTS.md:1.",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "*": "deny",
          "interpreter": "allow",
          "verify": "allow",
          "explore": "allow",
          "general": "deny"
        }
      }
    },
    "interpreter": { "prompt": "skills/interpreter/SKILL.md", "mode": "subagent" },
    "verify": { "prompt": "skills/verify/SKILL.md", "mode": "subagent" }
  },
  "plugin": ["./plugins/force-delegation.js", "cgasgarth/opencode-dynamic-subagents"],
  "mcp": {
    "palank-domain": { "type": "local", "command": ["node", "mcp/server.js"], "enabled": true }
    // Domain HTTP (project-specific): copy to enable
    // "jipkkumida-domain": { "type": "remote", "url": "https://your-domain/api/mcp", "enabled": true }
  },
  "instructions": ["AGENTS.md"]
}
