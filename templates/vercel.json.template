{
  // templates/vercel.json.template — Vercel Bundling Template (JSONC)
  // Copy to ./vercel.json and adjust. JSONC comments are for template only — strip // before deploy if strict JSON required.
  // Raw: https://vercel.com/docs/projects/project-configuration  (vercel.json, functions.includeFiles)
  // Thin: harness is disposable, wiki is spec — if api/*.ts does fs.readFileSync on wiki/raw, you MUST bundle those files.
  // Otherwise Vercel excludes .vercelignore entries and get_leak_constants will ENOENT in production.
  "functions": {
    // Example: wiki proxy (leak-whisperer api/mcp.ts → .wiki/wiki/topics/knowledge-base.md)
    "api/mcp.ts": { "includeFiles": ".wiki/wiki/topics/**" },
    // Example: blog prerender artifacts
    "api/blog-index.ts": { "includeFiles": "dist/index.html" },
    "api/blog-detail.ts": { "includeFiles": "dist/index.html" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/mcp", "destination": "/api/mcp" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
