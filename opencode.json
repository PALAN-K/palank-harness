{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta/muse-spark-1.2",
  "provider": {
    "meta": {
      "name": "Meta Model API",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://api.meta.ai/v1"
      },
      "models": {
        "muse-spark-1.2": {
          "name": "muse-spark-1.2",
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": { "input": ["text", "image", "pdf", "video"], "output": ["text"] },
          "options": { "reasoningEffort": "medium", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] }
        }
      }
    },
    "qwen": {
      "name": "Qwen",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1" },
      "models": {
        "qwen3.8-pro": { "name": "qwen3.8-pro", "limit": { "context": 1048576, "output": 131072 } }
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://api.deepseek.com/v1" },
      "models": {
        "deepseek-v4-flash": { "name": "deepseek-v4-flash", "limit": { "context": 131072, "output": 8192 } },
        "deepseek-v4-pro": { "name": "deepseek-v4-pro", "limit": { "context": 131072, "output": 8192 } }
      }
    }
  },
  "agent": {
    "conductor": {
      "mode": "primary",
      "description": "Conductor — primary orchestrator, no direct edits. MUST delegate via Task to interpreter/verify.",
      "prompt": "You are Conductor. NEVER write/edit files yourself. First tool MUST be Task to interpreter or verify. See AGENTS.md:1.",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "*": "deny",
          "interpreter": "allow",
          "verify": "allow",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "interpreter": { "model": "meta/muse-spark-1.2", "prompt": "skills/interpreter/SKILL.md", "mode": "subagent" },
    "verify": { "model": "qwen/qwen3.8-pro", "prompt": "skills/verify/SKILL.md", "mode": "subagent" }
  },
  "plugin": ["./plugins/force-delegation.js", "cgasgarth/opencode-dynamic-subagents"],
  "mcp": {
    "palank-domain": { "command": "node", "args": ["mcp/server.js"], "enabled": true }
  },
  "instructions": ["AGENTS.md"]
}
