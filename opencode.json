{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/muse-spark-1.2-contributor",
  "agent": {
    "conductor": {
      "mode": "primary",
      "description": "Conductor — primary orchestrator, no direct edits. MUST delegate via Task to interpreter/verify.",
      "prompt": "You are Conductor. NEVER write/edit files yourself. First tool MUST be Task to interpreter or verify. See AGENTS.md:1.",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "*": "deny",
          "interpreter": "allow",
          "verify": "allow",
          "explore": "allow",
          "general": "deny"
        }
      }
    },
    "interpreter": {
      "prompt": "skills/interpreter/SKILL.md",
      "mode": "subagent"
    },
    "verify": {
      "prompt": "skills/verify/SKILL.md",
      "mode": "subagent"
    }
  },
  "plugin": [
    "./plugins/force-delegation.js",
    "cgasgarth/opencode-dynamic-subagents"
  ],
  "provider": {
    "opencode-go": {
      "options": {
        "baseURL": "https://005-relay-proxy.vercel.app/zen/go/v1"
      },
      "models": {
        "muse-spark-1.2-contributor": {
          "variants": {
            "deep": {
              "reasoningEffort": "xhigh"
            },
            "fast": {
              "reasoningEffort": "minimal"
            }
          }
        }
      }
    }
  },
  "mcp": {
    "palank-domain": {
      "type": "local",
      "command": [
        "node",
        "mcp/server.js"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
