{
  "$schema": "https://github.com/cgasgarth/opencode-dynamic-subagents/blob/main/dynamicSubAgents.schema.json",
  "version": 1,
  "defaults": {
    "prompt": "Palank subagent ??inherits AGENTS.md, delegates via Task only if needed.",
    "temperature": 0.2,
    "hidden": false,
    "steps": 30,
    "allowedModels": [
      { "id": "tier:minimal", "name": "minimal", "description": "Title/summary/compaction ??minimal reasoning, fastest" },
      { "id": "tier:bulk-cheap", "name": "bulk-cheap", "description": "Bulk generation, cheap, long context" },
      { "id": "tier:terminal-strong", "name": "terminal-strong", "description": "Terminal/tool-heavy, strong" },
      { "id": "tier:reasoning-frontier", "name": "reasoning-frontier", "description": "Hard reasoning, frontier, expensive" }
    ],
    "allowedVariants": ["low", "medium", "high"]
  },
  "limits": { "maxSubagentNameLength": 64 }
}
