#!/bin/sh
# pre-commit — thin harness hermetic guard (foundry + vault)
# Zero-dep, fail-closed. Foundry is hermetic per-project.
[ ! -f scripts/check_vault.js ] && exit 0
[ ! -f scripts/tiered-verify.js ] && exit 0

node scripts/verify-tiered.js
EC=$?
if [ $EC -eq 0 ]; then
  echo "tiered SKIPPED or verify PASS (see tier line above)"
  exit 0
fi
echo "verify failed — commit blocked"
exit $EC
